          "properties": {
            "gateBlocking": false,
            "exploitScenario": "An attacker tries to forge log entries by embedding CRLF in the URL or User-Agent. The Node HTTP parser rejects raw CR/LF in the request target and header values, and in production the log message is JSON-serialized (newlines escaped), so a forged multi-line entry is not achievable.",
            "confidence": "medium",
            "sanitizersEncountered": [
              "Node HTTP (llhttp) parser rejects raw CR/LF in the request target and header values",
              "production JSON log serialization (tslog type:json / Winston format.json) escapes embedded newlines"
            ],
            "intermediateHopsSummary": "request originalUrl (L11) + user-agent header (L12) -> this.logger.log template (L17)"
          }
