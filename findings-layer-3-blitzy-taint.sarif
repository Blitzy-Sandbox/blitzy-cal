          "level": "note",
          "message": {
            "text": "Log-injection candidate: exception.message interpolated into a NestJS error log in the HTTP exception filter; demoted (Winston JSON serialization; headers filtered; body/url in a structured object)."
          },
          "locations": [
            {
              "physicalLocation": {
