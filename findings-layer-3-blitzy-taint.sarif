      "tool": {
        "driver": {
          "name": "Blitzy-Taint-Layer3",
          "informationUri": "https://cwe.mitre.org/",
          "version": "1.0.0",
          "rules": [
            {
              "id": "CWE-117",
              "name": "LogInjection",
              "shortDescription": {
                "text": "Improper Output Neutralization for Logs (Log Injection)"
              },
              "fullDescription": {
                "text": "Untrusted input is written to logs without neutralizing CR/LF and other control characters, allowing log forging or downstream log-processing injection."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/117.html",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-117"
                ]
              }
            },
            {
              "id": "CWE-338",
              "name": "WeakPRNG",
              "shortDescription": {
                "text": "Use of Cryptographically Weak Pseudo-Random Number Generator (PRNG)"
              },
              "fullDescription": {
                "text": "A non-cryptographic PRNG (e.g. Math.random) is used to generate a security-sensitive value such as a token, secret, nonce, or reset code."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/338.html",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-338"
                ]
              }
            },
            {
              "id": "CWE-601",
              "name": "OpenRedirect",
              "shortDescription": {
                "text": "URL Redirection to Untrusted Site (Open Redirect)"
              },
              "fullDescription": {
                "text": "A web application redirects to a URL derived from untrusted input without validating it against an allowlist, enabling phishing or token leakage."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/601.html",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-601"
                ]
              }
            },
            {
              "id": "CWE-807",
              "name": "UntrustedInputInSecurityDecision",
              "shortDescription": {
                "text": "Reliance on Untrusted Inputs in a Security Decision"
              },
              "fullDescription": {
                "text": "A security decision (authentication, authorization, rate limiting) is made based on an input the attacker can control without adequate verification."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/807.html",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-807"
                ]
              }
            },
            {
              "id": "CWE-843",
              "name": "TypeConfusion",
              "shortDescription": {
                "text": "Access of Resource Using Incompatible Type (Type Confusion)"
              },
              "fullDescription": {
                "text": "A value is accessed assuming one type when an incompatible type is possible (e.g. string vs string[] from req.query), reaching a security- or correctness-sensitive operation."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/843.html",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-843"
                ]
              }
            },
            {
              "id": "CWE-862",
              "name": "MissingAuthorization",
              "shortDescription": {
                "text": "Missing Authorization"
              },
              "fullDescription": {
                "text": "A resource or state-changing operation is exposed without an authorization check, allowing actors to perform actions they should not be permitted to."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/862.html",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-862"
                ]
              }
            },
            {
              "id": "CWE-918",
              "name": "SSRF",
              "shortDescription": {
                "text": "Server-Side Request Forgery (SSRF)"
              },
              "fullDescription": {
                "text": "The server is induced to make a request to a URL derived from untrusted input, potentially reaching internal services or cloud metadata endpoints."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/918.html",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-918"
                ]
              }
            }
          ]
        }
