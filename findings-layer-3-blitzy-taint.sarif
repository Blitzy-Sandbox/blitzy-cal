{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Blitzy-Taint-Layer3",
          "organization": "Blitzy",
          "informationUri": "https://cwe.mitre.org/",
          "version": "1.0.0",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "CWE-601",
              "name": "OpenRedirect",
              "shortDescription": {
                "text": "URL Redirection to Untrusted Site ('Open Redirect')"
              },
              "fullDescription": {
                "text": "The product uses externally controlled input to construct a redirect target without restricting it to trusted destinations, allowing redirection to an attacker-controlled URL."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/601.html",
              "properties": {
                "category": "taint"
              }
            },
            {
              "id": "CWE-918",
              "name": "ServerSideRequestForgery",
              "shortDescription": {
                "text": "Server-Side Request Forgery (SSRF)"
              },
              "fullDescription": {
                "text": "The product fetches a remote resource using a user-controllable URL without sufficiently validating that the destination is permitted, allowing requests to internal or otherwise unintended hosts."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/918.html",
              "properties": {
                "category": "taint"
              }
            },
            {
              "id": "CWE-117",
              "name": "ImproperOutputNeutralizationForLogs",
              "shortDescription": {
                "text": "Improper Output Neutralization for Logs (Log Injection)"
              },
              "fullDescription": {
                "text": "The product writes externally controlled data to a log without neutralizing CR/LF or other control sequences, allowing forged or misleading log entries."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/117.html",
              "properties": {
                "category": "taint"
              }
            },
            {
              "id": "CWE-807",
              "name": "RelianceOnUntrustedInputsInSecurityDecision",
              "shortDescription": {
                "text": "Reliance on Untrusted Inputs in a Security Decision"
              },
              "fullDescription": {
                "text": "The product makes a security-relevant decision (authentication, authorization, signature/secret verification, or identity) based on inputs that can be controlled or spoofed by an attacker, or compares secrets in a non-constant-time manner."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/807.html",
              "properties": {
                "category": "taint"
              }
            },
            {
              "id": "CWE-338",
              "name": "UseOfCryptographicallyWeakPRNG",
              "shortDescription": {
                "text": "Use of Cryptographically Weak Pseudo-Random Number Generator (PRNG)"
              },
              "fullDescription": {
                "text": "The product uses a non-cryptographic PRNG (such as Math.random) to generate a security-sensitive value, making the value predictable."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/338.html",
              "properties": {
                "category": "taint"
              }
            },
            {
              "id": "CWE-843",
              "name": "TypeConfusion",
              "shortDescription": {
                "text": "Access of Resource Using Incompatible Type ('Type Confusion')"
              },
              "fullDescription": {
                "text": "The product accesses a value using an incompatible type (for example, treating a string|string[] union inconsistently), which can lead to logic or security errors."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/843.html",
              "properties": {
                "category": "taint"
              }
            },
            {
              "id": "CWE-862",
              "name": "MissingAuthorization",
              "shortDescription": {
                "text": "Missing Authorization"
              },
              "fullDescription": {
                "text": "The product does not perform an authorization check before allowing access to a resource or the execution of an operation, enabling unauthorized actions."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/862.html",
              "properties": {
                "category": "taint"
              }
            }
          ]
        }
