                          },
                          "region": {
                            "startLine": 21
                          }
                        },
                        "message": {
                          "text": "source: exception?.message (may echo user-supplied input)"
                        }
                      }
                    },
                    {
                      "location": {
                        "physicalLocation": {
                          "artifactLocation": {
                            "uri": "apps/api/v2/src/filters/http-exception.filter.ts"
                          },
                          "region": {
                            "startLine": 21
                          }
                        },
                        "message": {
                          "text": "sink: this.logger.error(`Http Exception Filter: ${exception?.message}`, { body, url, headers: filterReqHeaders(...) })"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "properties": {
            "gateBlocking": false,
            "exploitScenario": "An attacker triggers an exception whose message echoes attacker input containing newlines. The v2 Winston logger uses format.json() in production (newlines escaped), filterReqHeaders sanitizes headers, and body/url are passed as a structured object that is JSON-serialized, demoting this to a note.",
            "confidence": "low",
            "sanitizersEncountered": [
              "v2 Winston format.json escapes newlines in production [apps/api/v2/src/lib/logger.ts]",
              "filterReqHeaders sanitizes headers; body/url placed in a structured object that is JSON-serialized"
            ],
            "intermediateHopsSummary": "exception.message (L21) -> this.logger.error template (L21)"
          }
        },
